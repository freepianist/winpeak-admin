// Keep in sync with the public site prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LedgerKind {
  BET
  WIN
  CANCEL
  DEPOSIT
  WITHDRAW
}

enum WalletRequestType {
  DEPOSIT
  WITHDRAW
}

enum WalletRequestStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AffiliateDealType {
  CPA
  REVSHARE
  HYBRID
}

enum AffiliateStatus {
  INVITED
  ACTIVE
  PAUSED
  CLOSED
}

enum CommissionKind {
  CPA
  REVSHARE
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

enum PayoutStatus {
  PENDING
  SENT
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

enum StaffRole {
  AFFILIATE_MANAGER
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

model StaffAccount {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         StaffRole   @default(AFFILIATE_MANAGER)
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  passwordHash          String
  firstName             String
  lastName              String
  scorpioPlayerCode     Int?
  status                UserStatus             @default(ACTIVE)
  notes                 String?
  referredByAffiliateId String?
  referredBy            AffiliatePartner?      @relation(fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  firstDepositAt        DateTime?
  emailVerifiedAt       DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  wallet                Wallet?
  ledger                LedgerEntry[]
  walletRequests        WalletRequest[]
  reviews               GameReview[]
  reviewReplies         GameReviewReply[]
  commissions           AffiliateCommission[]
  authTokens            AuthToken[]

  @@index([createdAt])
  @@index([status])
  @@index([referredByAffiliateId])
}

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Decimal  @default(0) @db.Decimal(18, 4)
  heldBalance Decimal  @default(0) @db.Decimal(18, 4)
  currency    String   @default("USD")
  updatedAt   DateTime @updatedAt
}

model WalletRequest {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           WalletRequestType
  amount         Decimal             @db.Decimal(18, 4)
  status         WalletRequestStatus @default(PENDING)
  note           String?
  reviewNote     String?
  reviewedBy     String?
  reviewedAt     DateTime?
  payCurrency    String?
  payoutAddress  String?
  invoiceUrl     String?
  providerRef    String?             @unique
  providerStatus String?
  autoProcessed  Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model LedgerEntry {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerTxId String?    @unique
  referenceId  String?
  roundId      String?
  kind         LedgerKind
  amount       Decimal    @db.Decimal(18, 4)
  balanceAfter Decimal    @db.Decimal(18, 4)
  providerId   Int?
  gameCode     String?
  createdAt    DateTime   @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([roundId])
  @@index([referenceId])
}

model GameReview {
  id          String            @id @default(cuid())
  providerId  Int
  gameCode    String
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  authorEmail String
  rating      Int
  content     String
  createdAt   DateTime          @default(now())
  replies     GameReviewReply[]

  @@index([providerId, gameCode, createdAt(sort: Desc)])
}

model GameReviewReply {
  id         String     @id @default(cuid())
  reviewId   String
  review     GameReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  content    String
  createdAt  DateTime   @default(now())

  @@index([reviewId, createdAt])
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  body        String        @db.Text
  image       String
  tag         String
  author      String
  authorImage String
  publishedAt DateTime      @default(now())
  comments    BlogComment[]

  @@index([publishedAt(sort: Desc)])
}

model BlogComment {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  content     String
  createdAt   DateTime @default(now())

  @@index([postId, createdAt])
}

model SuccessStory {
  id         String   @id @default(cuid())
  authorName String
  role       String   @default("Player")
  content    String
  image      String   @default("/images/avatar/one.png")
  rating     Int      @default(5)
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([read])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model AffiliatePartner {
  id              String                 @id @default(cuid())
  email           String                 @unique
  name            String
  passwordHash    String?
  code            String                 @unique
  dealType        AffiliateDealType
  cpaAmount       Decimal?               @db.Decimal(18, 4)
  revSharePercent Decimal?               @db.Decimal(6, 2)
  minFtdAmount    Decimal                @default(0) @db.Decimal(18, 4)
  status          AffiliateStatus        @default(INVITED)
  notes           String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  players         User[]
  commissions     AffiliateCommission[]
  payouts         AffiliatePayout[]

  @@index([status])
  @@index([code])
}

model AffiliateCommission {
  id          String           @id @default(cuid())
  partnerId   String
  partner     AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind        CommissionKind
  amount      Decimal          @db.Decimal(18, 4)
  basisAmount Decimal          @default(0) @db.Decimal(18, 4)
  status      CommissionStatus @default(PENDING)
  createdAt   DateTime         @default(now())

  @@index([partnerId, createdAt(sort: Desc)])
  @@index([status])
}

model AffiliatePayout {
  id        String           @id @default(cuid())
  partnerId String
  partner   AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount    Decimal          @db.Decimal(18, 4)
  status    PayoutStatus     @default(PENDING)
  note      String?
  createdAt DateTime         @default(now())

  @@index([partnerId, createdAt(sort: Desc)])
}
