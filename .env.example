# Public URL of this admin app
NEXT_PUBLIC_BASE_URL=https://admin.example.com
AUTH_URL=https://admin.example.com

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Same PostgreSQL database as the public WinPeak site
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/winpeak?sslmode=require

# Staff sign-in (set a strong unique password in the host env)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional bootstrap affiliate manager (or add managers from the admin UI)
# AFFILIATE_MANAGER_EMAIL=
# AFFILIATE_MANAGER_PASSWORD=

# Public player site origin, used in affiliate tracking links and payout IPN
WINPEAK_SITE_URL=https://winpeakgames.com

# NOWPayments — used when staff approve a crypto withdrawal
# Quote any value containing '#', or dotenv truncates it at that character and
# /auth fails with a misleading 403 ACCESS_DENIED:
#   NOWPAYMENTS_PASSWORD="s3cret#value"
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
# Fallback network when a request has none recorded
NOWPAYMENTS_PAYOUT_CURRENCY=usdttrc20
# NOWPAYMENTS_2FA_SECRET=
# Static-IP proxy for every outbound NOWPayments call. The IP whitelist is tied
# to the API key, and serverless egress IPs change per request, so the whitelisted
# address has to be borrowed from a proxy. Use the same value as the player site.
# Must be an HTTP(S) proxy; SOCKS is not supported.
NOWPAYMENTS_PROXY_URL=http://user:password@host:port

# The one network the casino settles in. Payouts in any other coin are funded
# from it via a Custody conversion. Keep in sync with the player site.
NOWPAYMENTS_SETTLEMENT_CURRENCY=usdttrc20
WITHDRAW_CONVERSION_BUFFER_PCT=2

# Cloudinary — required on hosted deploys so blog and story images appear on the player site
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional local fallback if Cloudinary is unset: absolute path to the public site /public folder
# WINPEAK_PUBLIC_ROOT=/var/www/winpeak
